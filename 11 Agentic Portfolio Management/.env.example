# Agentic Portfolio Management - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# Application Configuration
# ============================================================================
ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR, CRITICAL
DEBUG=true

# ============================================================================
# LLM Provider Configuration
# ============================================================================
# Choose your LLM provider: "openai" or "anthropic"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo-preview  # or gpt-4, gpt-3.5-turbo
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORGANIZATION=org-your-org-id  # Optional

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# LLM Cost Management
MAX_DAILY_LLM_COST_USD=100.0
ALERT_LLM_COST_THRESHOLD_USD=80.0

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection URL
DATABASE_URL=postgresql://agentic_pm:your_password@localhost:5432/agentic_pm

# Connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ============================================================================
# Redis Configuration (Message Bus & Caching)
# ============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=  # Leave empty if no password
REDIS_MAX_CONNECTIONS=50

# Cache TTL (seconds)
CACHE_TTL_MARKET_DATA=300      # 5 minutes
CACHE_TTL_AGENT_SIGNALS=60     # 1 minute
CACHE_TTL_PORTFOLIO=30         # 30 seconds

# ============================================================================
# QuantConnect Configuration
# ============================================================================
QC_API_USER_ID=your_user_id_here
QC_API_TOKEN=your_api_token_here
QC_ORGANIZATION_ID=your_organization_id_here

# QuantConnect project IDs for strategy integration
QC_PROJECT_MOMENTUM=project_id_1
QC_PROJECT_MEAN_REVERSION=project_id_2
QC_PROJECT_ML_STRATEGY=project_id_3

# ============================================================================
# Brokerage Integration Configuration
# ============================================================================
# Enable/disable specific brokerages
ENABLE_ROBINHOOD=true
ENABLE_ALPACA=true
ENABLE_INTERACTIVE_BROKERS=false

# Robinhood Configuration (unofficial API)
ROBINHOOD_USERNAME=your_robinhood_username
ROBINHOOD_PASSWORD=your_robinhood_password
ROBINHOOD_MFA_CODE=  # Leave empty if using saved device token
# Note: After first login, a device token is saved for future use

# Alpaca Configuration (official API)
ALPACA_API_KEY=your_alpaca_key
ALPACA_SECRET_KEY=your_alpaca_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # Use https://api.alpaca.markets for live

# Interactive Brokers Configuration (official API)
IB_HOST=127.0.0.1
IB_PORT=7497  # 7497 for TWS paper, 7496 for TWS live, 4002 for Gateway paper, 4001 for Gateway live
IB_CLIENT_ID=1
IB_ACCOUNT_ID=  # Your IB account ID (optional)

# Portfolio Sync Configuration
PORTFOLIO_SYNC_ENABLED=true
PORTFOLIO_SYNC_INTERVAL=60  # seconds between syncs
PORTFOLIO_CACHE_ENABLED=true
PORTFOLIO_CACHE_TTL=60  # seconds

# ============================================================================
# Market Data Configuration
# ============================================================================
# Primary data source: "quantconnect", "yfinance", "alpaca"
MARKET_DATA_SOURCE=quantconnect

# Backup data sources (comma-separated)
MARKET_DATA_FALLBACK=yfinance,alpaca

# Alpha Vantage API (optional, for additional data)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# ============================================================================
# Risk Management Configuration
# ============================================================================
# Position size limits
MAX_POSITION_SIZE_PCT=0.10          # 10% max per position
MAX_SECTOR_EXPOSURE_PCT=0.30        # 30% max per sector
MIN_POSITION_SIZE_USD=100           # Minimum position size

# Portfolio risk limits
MAX_PORTFOLIO_VOLATILITY=0.15       # 15% annualized volatility
MAX_DRAWDOWN_PCT=0.20               # 20% max drawdown
TARGET_SHARPE_RATIO=1.5             # Target Sharpe ratio

# Risk-free rate for calculations
RISK_FREE_RATE=0.04                 # 4% annual

# Liquidity requirements
MIN_LIQUIDITY_DAYS=3                # Minimum days to liquidate position
MIN_DAILY_VOLUME_USD=1000000        # $1M minimum daily volume

# Correlation limits
MAX_CORRELATION_THRESHOLD=0.80      # Max correlation between positions

# ============================================================================
# Agent Configuration
# ============================================================================
# Agent execution schedule (cron expressions)
AGENT_SCHEDULE_PREMARKET=0 8 * * 1-5     # 8:00 AM weekdays
AGENT_SCHEDULE_MARKET_OPEN=30 9 * * 1-5  # 9:30 AM weekdays
AGENT_SCHEDULE_MARKET_CLOSE=0 16 * * 1-5 # 4:00 PM weekdays

# Agent trust score settings
INITIAL_TRUST_SCORE=50.0
MIN_TRUST_SCORE=0.0
MAX_TRUST_SCORE=100.0
TRUST_SCORE_DECAY_RATE=0.01         # Daily decay rate

# Agent timeout settings (seconds)
AGENT_EXECUTION_TIMEOUT=60
AGENT_LLM_TIMEOUT=30

# ============================================================================
# Orchestrator Configuration
# ============================================================================
# Minimum number of agent recommendations required
MIN_AGENT_RECOMMENDATIONS=2

# Conflict resolution strategy: "trust_weighted", "majority", "risk_adjusted"
CONFLICT_RESOLUTION_STRATEGY=trust_weighted

# Minimum conviction score to act on recommendation (0-100)
MIN_CONVICTION_THRESHOLD=60

# Require human approval for all recommendations
REQUIRE_HUMAN_APPROVAL=true

# Auto-execute high conviction recommendations (only if REQUIRE_HUMAN_APPROVAL=false)
AUTO_EXECUTE_CONVICTION_THRESHOLD=90

# ============================================================================
# Research Agent Configuration
# ============================================================================
# Enable automated backtesting
ENABLE_AUTO_BACKTESTING=true

# Backtest frequency (days)
BACKTEST_FREQUENCY_DAYS=7

# Number of parameter variations to test
BACKTEST_PARAM_COMBINATIONS=10

# Minimum improvement threshold to propose changes (%)
MIN_IMPROVEMENT_THRESHOLD_PCT=5.0

# ============================================================================
# API Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true  # Set to false in production

# CORS settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
CORS_ALLOW_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ============================================================================
# Authentication & Security
# ============================================================================
# JWT secret key (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-generate-with-openssl-rand-hex-32

# JWT settings
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API Key for programmatic access
API_KEY=your-api-key-for-programmatic-access

# ============================================================================
# Monitoring & Observability
# ============================================================================
# Prometheus metrics
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090

# Sentry error tracking (optional)
SENTRY_DSN=  # Your Sentry DSN here
SENTRY_ENVIRONMENT=development

# DataDog APM (optional)
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com

# ============================================================================
# Notification Configuration
# ============================================================================
# Enable notifications
ENABLE_NOTIFICATIONS=true

# Email notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
ALERT_EMAIL_TO=recipient@example.com

# Slack notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================================
# Backup & Disaster Recovery
# ============================================================================
# Database backup settings
ENABLE_AUTO_BACKUP=true
BACKUP_SCHEDULE=0 2 * * *  # 2:00 AM daily
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket  # For AWS S3 backups

# AWS credentials for backups (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ============================================================================
# Feature Flags
# ============================================================================
# Enable/disable features
ENABLE_SENTIMENT_AGENT=true
ENABLE_ML_STRATEGY_AGENT=true
ENABLE_RESEARCH_AGENT=true
ENABLE_PAPER_TRADING=true
ENABLE_LIVE_TRADING=false  # WARNING: Set to true only after thorough testing

# ============================================================================
# Development & Testing
# ============================================================================
# Use mock data for testing
USE_MOCK_DATA=false
MOCK_DATA_PATH=./tests/fixtures/mock_data.json

# Testing mode (disables real API calls)
TESTING_MODE=false

# Seed for reproducibility in backtests
RANDOM_SEED=42
