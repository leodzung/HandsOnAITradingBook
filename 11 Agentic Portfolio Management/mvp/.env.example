# Agentic Portfolio Manager MVP - Configuration Template
# Copy this file to .env and fill in your values
#
# LLM Priority: Gemini (primary) -> Ollama (fallback)
# The system tries Gemini first. If it fails (quota, error), it falls back to Ollama.

# ===========================================
# GEMINI CONFIGURATION (Primary - Cloud)
# ===========================================
# Get API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ===========================================
# OLLAMA CONFIGURATION (Fallback - Local, FREE)
# ===========================================
# Install: brew install ollama && ollama serve && ollama pull qwen2.5:14b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
# Alternative models: qwen2.5:7b, qwen2.5:32b, llama3.2, mistral, deepseek-r1:14b

# ===========================================
# ALPACA CONFIGURATION (Paper Trading)
# ===========================================
# Get your keys from: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ===========================================
# RISK MANAGEMENT SETTINGS
# ===========================================
MAX_POSITION_SIZE_PCT=0.10      # Max 10% of portfolio in single position
MAX_PORTFOLIO_VOLATILITY=0.15   # Target max 15% annual volatility
MIN_CASH_RESERVE_PCT=0.05       # Keep at least 5% cash

# ===========================================
# ANALYSIS SETTINGS
# ===========================================
LOOKBACK_DAYS=60                # Days of history for momentum analysis
MOMENTUM_THRESHOLD=0.05         # 5% threshold for momentum signals
