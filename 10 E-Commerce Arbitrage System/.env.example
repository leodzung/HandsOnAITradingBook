# E-Commerce Arbitrage System - Environment Variables
# Copy this file to .env and fill in your credentials

# Amazon SP-API (Selling Partner API)
AMAZON_SP_REFRESH_TOKEN=your_refresh_token_here
AMAZON_SP_CLIENT_ID=your_client_id_here
AMAZON_SP_CLIENT_SECRET=your_client_secret_here
AMAZON_SP_MARKETPLACE_ID=ATVPDKIKX0DER

# Amazon Product Advertising API
AMAZON_PA_ACCESS_KEY=your_access_key_here
AMAZON_PA_SECRET_KEY=your_secret_key_here
AMAZON_PA_PARTNER_TAG=your_associate_tag_here

# Keepa API
KEEPA_API_KEY=your_keepa_api_key_here

# Rainforest API (Optional)
RAINFOREST_API_KEY=your_rainforest_api_key_here

# Retail APIs
WALMART_API_KEY=your_walmart_api_key_here
BESTBUY_API_KEY=your_bestbuy_api_key_here
TARGET_API_KEY=your_target_api_key_here

# Email Notifications
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com

# Telegram Bot (Optional)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Twilio SMS (Optional)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBERS=+1234567890,+0987654321

# Database
DATABASE_PATH=data/deals.db

# General Settings
MIN_ROI=30.0
MIN_PROFIT=5.0
LOG_LEVEL=INFO
